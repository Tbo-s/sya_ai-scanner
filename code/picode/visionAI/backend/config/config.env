# This document is used to document the environment variables used by the application.

# Notes
APP_NOTES_NUMBER_MAX=10
APP_NOTES_TITLE_LENGTH_MAX=50
APP_NOTES_CONTENT_LENGTH_MAX=500

# ArangoDB
APP_ARANGODB_HOST=...
APP_ARANGODB_PORT=...
APP_ARANGODB_DATABASE=...
APP_ARANGODB_USER=...
APP_ARANGODB_PASSWORD=...

# Arduino Leonardo runtime link via USB-TTL adapter on Serial1.
# APP_ARDUINO_PORT is kept for backward compatibility.
# On the Pi we currently see the Leonardo USB-TTL adapter as the stable CH340 by-id device,
# while the GRBL board enumerates as /dev/ttyUSB1.
APP_ARDUINO_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
APP_LEONARDO_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
APP_LEONARDO_BAUD=115200

# Arduino Mega (GRBL / NEMA17 control)
APP_GRBL_PORT=/dev/ttyUSB1
APP_GRBL_BAUD=115200
APP_GRBL_READ_TIMEOUT_S=2.0
APP_GRBL_STATUS_TIMEOUT_S=2.0
APP_GRBL_MOTION_TIMEOUT_S=60.0
APP_GRBL_MANUAL_SETTLE_DELAY_S=0.12
APP_GRBL_STARTUP_DELAY_S=2.0
APP_GRBL_POSTFLOW_ENABLED=0
APP_GRBL_POSTFLOW_SEQUENCE=$X|$H
APP_GRBL_HOME_ON_BOOT=1
APP_GRBL_HOME_XY_AXIS_ORDER=X,Y
APP_GRBL_HOME_XY_SEARCH_DISTANCE=1000.0
APP_GRBL_HOME_XY_FEED_RATE=60
APP_GRBL_HOME_Z_CLEARANCE=2.0
APP_GRBL_HOME_Z_STEP=1.0
APP_GRBL_HOME_Z_SEARCH_DISTANCE=100.0
APP_GRBL_HOME_Z_FEED_RATE=30
APP_GRBL_BOOT_SEQUENCE_ENABLED=0
APP_GRBL_BOOT_SEQUENCE=$X|$H
APP_GRBL_TEST_SPIN_ON_UI_START=0
APP_GRBL_TEST_SPIN_AXIS=X
APP_GRBL_TEST_SPIN_DISTANCE=100000
APP_GRBL_TEST_SPIN_FEED_RATE=300

# Scan / motion tuning
APP_LEONARDO_WARM_ON_BOOT=1
APP_LEONARDO_PERSISTENT_SERIAL=1
APP_LEONARDO_OPEN_DELAY_S=0.05
APP_LEONARDO_COMMAND_OPEN_DELAY_S=0.05
APP_LEONARDO_POST_WRITE_HOLD_S=0.02
APP_LEONARDO_WRITE_RETRY_DELAY_S=0.10
APP_LEONARDO_WRITE_TIMEOUT_S=1.0
APP_LEONARDO_READ_TIMEOUT_S=0.8
APP_LEONARDO_STATUS_RETRIES=3
APP_LEONARDO_STATUS_RETRY_DELAY_S=0.10
APP_LEONARDO_POLL_STATUS_TIMEOUT_S=0.1
APP_GATE_MOVE_TIMEOUT_S=10
APP_TRAY_MOVE_TIMEOUT_S=10
APP_WRIST_MIN_ANGLE=-5
APP_WRIST_MAX_ANGLE=182
APP_WRIST1_MIN_ANGLE=32
APP_WRIST1_MAX_ANGLE=152
APP_WRIST1_HOME_ANGLE=93
APP_WRIST2_MIN_ANGLE=-90
APP_WRIST2_MAX_ANGLE=90
APP_WRIST_DWELL_MS=600
APP_WRIST_SMOOTH_STEP_DEG=2
APP_WRIST_SMOOTH_DELAY_MS=25
APP_VACUUM_DWELL_S=1.0
APP_ARM_DISTANCE_THRESHOLD_CM=3
APP_GRBL_FEED_RATE=3000
APP_GRBL_FRONT_X=50.0
APP_GRBL_FRONT_Y=100.0
APP_GRBL_BACK_X=50.0
APP_GRBL_BACK_Y=20.0
APP_GRBL_Z_PICKUP=30.0
APP_GRBL_Z_TRAVEL=5.0
APP_GRBL_MANUAL_XY_STEP=0.5
APP_GRBL_MANUAL_XY_FEED_RATE=120
APP_GRBL_MAX_X=4.0
APP_GRBL_MAX_Y=5.5
APP_GRBL_LIMIT_PIN_MODE=active_present
APP_GRBL_CONFIGURE_NC_LIMITS=1
APP_GRBL_LIMIT_PINS_INVERT=1
APP_GRBL_X_LIMIT_TOWARD_ZERO_SIGN=-1
APP_GRBL_Y_LIMIT_TOWARD_ZERO_SIGN=-1
APP_GRBL_Z_LIMIT_TOWARD_ZERO_SIGN=-1
APP_GRBL_MANUAL_Z_STEP=5.0
APP_GRBL_MANUAL_Z_FEED_RATE=60
APP_USER_CONFIRM_TIMEOUT_S=300

# Cameras / storage
APP_CAMERA_INDEX=0
APP_PHOTO_STORAGE_DIR=/tmp/sya_photos
APP_CAMERA_CAPTURE_DIR=/home/pi/sya/captures
APP_PI_CAPTURE_DIR=/home/pi/sya/captures
APP_PI_CAMERA_FOCUS_RANGE=macro
APP_PI_CAMERA_AF_SPEED=normal
APP_PI_CAMERA_AF_WINDOW=0.25,0.25,0.5,0.5
APP_PI_CAMERA_LENS_POSITION=auto
APP_PI_CAMERA_WARMUP_MS=1200
APP_PI_CAMERA_FOCUS_SETTLE_MS=350
APP_PI_CAMERA_CLOSE_FOCUS_SWEEP=1
APP_PI_CAMERA_FOCUS_CANDIDATES=2.5,3.5,4.5,5.5,6.5,7.5,9.0,11.0
APP_PI_CAMERA_FOCUS_CACHE_TTL_S=300
# Optional override if the Pi camera command is not on PATH.
# APP_PI_STILL_COMMAND=/usr/bin/libcamera-still
APP_FRONTEND_DIST=/home/pi/sya/frontend/dist

# Boot behaviour
APP_MACHINE_SAFE_IDLE_ON_BOOT=1
APP_DEVICE_LOOKUP_API_ENABLED=0
APP_DEVICE_LOOKUP_API_URL=http://localhost:4000/api/v1/device-lookup
APP_DEVICE_LOOKUP_API_TIMEOUT_S=15
APP_AI_DAMAGE_API_MOCK=1
APP_AI_DAMAGE_API_URL=http://localhost:4000/api/v1/analyze
